APP_NAME=ElectricityPriceTest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=et
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync


ELERING_API_BASE_URL=https://dashboard.elering.ee/api/nps/price
PRICE_REGION=EE
CACHE_TTL_SECONDS=1800
VAT_RATE=0.24 # 0.24 = 24% VAT
NETWORK_FEE_EUR_PER_MWH=14.50
SUPPLIER_MARGIN_EUR_PER_MWH=10.0


RECIPIENT_EMAIL=
GITHUB_REPO_URL=
GITHUB_COMMIT_SHA=

# --- Mail (SMTP) ---
# For local testing without real SMTP you can use Mailpit/Mailhog
# (MAIL_MAILER=smtp, MAIL_HOST=mailpit, MAIL_PORT=1025) or MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
