{
    "rules": {
        "php_unit_method_casing": {
            "case": "camel_case"
        },
        "braces_position": {
            "classes_opening_brace": "same_line",
            "functions_opening_brace": "same_line"
        },
        "concat_space": {
            "spacing": "one"
        },
        "single_line_empty_body": false,
        "not_operator_with_successor_space": false,
        "new_with_parentheses": {
            "named_class": true,
            "anonymous_class": true
        }
    }
}
